# Copy this file to keystore.properties (same directory) and fill in real values.
# keystore.properties is gitignored — never commit real values.
#
# storeFile is resolved RELATIVE TO android/app/build.gradle, so a keystore
# living at the project root would be "../../your-release.jks".

storeFile=../../your-release.jks
storePassword=
keyAlias=
keyPassword=
